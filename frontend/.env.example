# OrbitShield Global Environment Variables

# Environment mode (development / production)
ENVIRONMENT=development

# Database Configuration (PostgreSQL in container or cloud; fallback to SQLite for immediate run)
DATABASE_URL=postgresql://orbituser:orbitpassword@localhost:5432/orbitshield_db

# Security
SECRET_KEY=orbitshield-super-secret-key-hackathon-2026-orbital

# Space Data Provider (Optional - CelesTrak public feed & Demo fallback used if empty)
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# AI Explanation Provider (Optional - Deterministic Flight Dynamics fallback used if empty)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Frontend API URL
VITE_API_URL=http://localhost:8000
